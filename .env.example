# Copy this file to .env and paste in your ESPN cookies. Never commit .env.
# Find them while logged in to fantasy.espn.com: browser dev tools > Application (Chrome)
# or Storage (Safari/Firefox) > Cookies > https://fantasy.espn.com
ESPN_S2=
# SWID includes the curly braces, e.g. {ABCD1234-....}
ESPN_SWID=
